{
	"compilerOptions": {
		"target": "ES2019",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2019"
		],
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"include": [
		"src/**/*",
		"test/**/*"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}